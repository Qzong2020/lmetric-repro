+import asyncio
+import httpx
+import argparse
+
+
+async def get_stream_response(port: int):
+    url = f"http://0.0.0.0:{port}/v1/metrics"
+
+    headers = {"Content-Type": "application/json"}
+
+    async with httpx.AsyncClient(timeout=None) as client:
+        async with client.stream("GET", url, headers=headers) as response:
+            async for line in response.aiter_lines():
+                line = line.strip()
+                print(line)
+
+
+def main():
+    parser = argparse.ArgumentParser(description="Stream metrics from a given port.")
+    parser.add_argument(
+        "--port",
+        type=int,
+        default=50180,
+        help="Port number for the metrics endpoint (default: 20003)"
+    )
+    args = parser.parse_args()
+
+    asyncio.run(get_stream_response(args.port))
+
+
+if __name__ == "__main__":
+    main()
