+/// Build text/usage from all real token IDs, including the finishing event.
+fn assemble_generated_text(
+    mut metadata: GeneratedText,
+    tokens: &[Token],
+    tokenizer: Option<&tokenizers::Tokenizer>,
+) -> Result<GeneratedText, InferError> {
+    metadata.generated_tokens = tokens.len() as u32;
+    metadata.text = if let Some(tokenizer) = tokenizer {
+        let ids: Vec<u32> = tokens.iter().map(|t| t.id).collect();
+        tokenizer.decode(&ids, true).map_err(|e| InferError::GenerationError(e.to_string()))?
+    } else {
+        tokens.iter().map(|t|t.text.as_str()).collect()
+    };
+    Ok(metadata)
